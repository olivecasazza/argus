{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "argus",
  "type": "object",
  "properties": {
    "forwarder": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            }
          },
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ]
        },
        "holmesUrl": {
          "type": "string"
        },
        "holmesModel": {
          "type": "string"
        },
        "holmesTimeoutSec": {
          "type": "integer",
          "minimum": 10
        },
        "investigateSeverities": {
          "type": "string"
        },
        "dedupeTtlSec": {
          "type": "integer",
          "minimum": 0
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR"
          ]
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "discordSecret": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "key"
          ]
        },
        "discordBotToken": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "discordControlChannelId": {
          "type": "string"
        },
        "githubToken": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "proposalsStorage": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "proposalsDbPath": {
          "type": "string"
        },
        "discordChannels": {
          "type": "object",
          "properties": {
            "default": {
              "type": "string"
            },
            "critical": {
              "type": "string"
            },
            "warning": {
              "type": "string"
            },
            "info": {
              "type": "string"
            },
            "deals": {
              "type": "string"
            }
          }
        },
        "repoMappings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "image",
        "holmesUrl",
        "holmesModel"
      ]
    },
    "holmes": {
      "type": "object"
    }
  },
  "required": [
    "forwarder"
  ]
}
